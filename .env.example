# PostgreSQL (orders-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ordersdb

# Stripe: usar siempre claves de PRUEBA (sk_test_..., whsec_...)
STRIPE_SECRET=
STRIPE_ENDPOINT_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/api/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/api/payments/cancelled

# auth-ms
MONGO_DB=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/AuthDB
JWT_SECRET=una_clave_larga_y_aleatoria

# client-gateway
CLIENT_GATEWAY_PORT=3000

# Solo para docker-compose.prod.yml (build de orders-ms)
ORDERS_MS_DATABASE=postgresql://USUARIO:CLAVE@HOST:5432/ordersdb?schema=public
